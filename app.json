{
  "expo": {
    "name": "Moon Player",
    "slug": "aura-player",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "aura",
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-router",
      [
        "obsidian-media-player/plugin",
        {
          "backgroundAudio": true
        }
      ],
      "expo-image"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aura.player",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.aura.player",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/app.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "appName": "Moon Player",
      "appVersion": "2.0.0"
    }
  }
}
